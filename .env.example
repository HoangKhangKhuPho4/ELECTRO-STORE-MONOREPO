# Copy file nay thanh .env (gitignore — khong commit mat khau)
#
# Local Docker (mac dinh — khuyen dung khi dev):
#   docker compose up -d
#   .\scripts\Import-Databases.ps1
#   .\START.ps1 -SkipDocker

# --- MySQL local (Docker electro-mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_USE_SSL=false
MYSQL_CREATE_DB=true

# Ten DB tung service (docker/mysql/init.sql + database/schemas/):
#   catalog-service    -> electro_catalog_db
#   user-service       -> electro_user_db
#   cart-service       -> electro_cart_db
#   order-service      -> electro_order_db
#   review-service     -> electro_review_db
#   statistics-service -> electro_statistics_db
#   reco-service       -> electro_statistics_db (user_interactions)

# --- Redis Cache Per Service (pattern redis-<domain>) ---
# auth-service        -> redis-auth        :6379  (refresh token)
# statistics-service  -> redis-statistics  :6380  (analytics queue)
# Chi Redis: .\scripts\Start-Redis.ps1
# KHONG dat AUTH_REDIS_URL / STATISTICS_REDIS_URL khi dev local
AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_USERNAME=
AUTH_REDIS_PASSWORD=
AUTH_REDIS_SSL=false

STATISTICS_REDIS_HOST=localhost
STATISTICS_REDIS_PORT=6380
STATISTICS_REDIS_USERNAME=
STATISTICS_REDIS_PASSWORD=
STATISTICS_REDIS_SSL=false

# JWT (cung secret cho auth-service, gateway, user/cart/order)
JWT_SECRET=your_jwt_signing_secret_min_32_chars

# --- Chatbot RAG (chatbot-service — NVIDIA NIM + Pinecone cloud) ---
# NVIDIA_API_KEY=nvapi-...
# PINECONE_API_KEY=pcsk-...
# PINECONE_INDEX_NAME=electro-store-products

TEST_USERNAME=khang_test
TEST_PASSWORD=your_test_password_here

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Gmail SMTP (forgot password) — https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_FROM_NAME=Electro Store
APP_FRONTEND_URL=http://localhost:5173

VNPAY_TMN_CODE=1T0D4TUS
VNPAY_HASH_SECRET=UNVQ0K206FIK1H2PNV667HPWJ2ARZMWD
PAYMENT_REFUND_SIMULATE=false
# Dev local: true neu PKIX path building failed khi hoan tien VNPay — KHONG bat production
PAYMENT_VNPAY_TRUST_ALL_SSL=false

